# ──────────────────────────────────────────────────────────────
# ISHINOL Indonesia — Environment Variables
# Copy this file to `.env` and fill in the values.
# ──────────────────────────────────────────────────────────────

# Database (PostgreSQL)
DATABASE_URL="postgresql://ishinol:ishinol@localhost:5432/ishinol?schema=public"

# NextAuth / Auth.js
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-secret"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# Public site URL (used for SEO, sitemap, canonical, OG)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Default seeded super-admin credentials
SEED_ADMIN_EMAIL="admin@ishinol.co.id"
SEED_ADMIN_PASSWORD="Ishinol#2026"

# Contact / business details (also editable from CMS Site Settings)
NEXT_PUBLIC_WHATSAPP_NUMBER="6285697777292"
NEXT_PUBLIC_CONTACT_EMAIL="info@ishinol.co.id"

# AI Content Assistant (optional — leave blank to disable AI buttons)
# Anthropic Claude API key — used by the CMS AI content assistant.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-4-8"

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
